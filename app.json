{
  "expo": {
    "name": "Smart E-Commerce",
    "slug": "SmartECommerce",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/appsplash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.robbaflow.SmartECommerce"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/appsplash.png",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "bd370060-7377-45c8-81f0-d20f8ababa35"
      }
    },
    "owner": "robbaflow"
  }
}
